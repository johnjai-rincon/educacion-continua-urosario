<figure class="testimonio" data-animate>
  <blockquote>{{ quote }}</blockquote>
  <figcaption>
    <span class="testimonio__avatar" aria-hidden="true">{{ iniciales|default(nombre|slice(0, 1)) }}</span>
    <div>
      <strong>{{ nombre }}</strong>
      <span>{{ cargo }}{% if cargo and empresa %} · {% endif %}{{ empresa }}</span>
    </div>
  </figcaption>
</figure>
